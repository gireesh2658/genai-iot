# IoTSynth AI Environment Configuration
# Copy to `.env` for local overrides. Leave secrets/tokens out of version control.

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
IOTSYNTH_DEFAULT_CTGAN_MODEL=ctgan_device_aware_v2
IOTSYNTH_DEBUG=false
# Optional Render/production overrides:
# CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:3000
# CORS_ORIGIN_REGEX=https://.*\.onrender\.com
# IOTSYNTH_GENERATED_DIR=/tmp/iotsynth_generated

NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000

SYNTHETIC_DEFAULT_EPOCHS=150
SYNTHETIC_BATCH_SIZE=500
SYNTHETIC_DEVICE=cpu
